{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/latidos-de-mexico.html/googleea7d02d04b945bef.html",
      "destination": "/googleea7d02d04b945bef.html"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/[...]"
    },
    {
      "source": "/inventario",
      "destination": "/inventario/login.html"
    }
  ]
}
